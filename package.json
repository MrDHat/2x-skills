{
  "name": "fin-2x-pi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fin 2x skills and integrations for Pi and Claude Code",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./plugins/skill-tools/skills",
      "./plugins/security-tools/skills",
      "./plugins/test-tools/skills",
      "./plugins/code-review-tools/skills",
      "./plugins/pr-tools/skills",
      "./pi/skills"
    ],
    "extensions": [
      "./pi/extensions/fin-2x.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
